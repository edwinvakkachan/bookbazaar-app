    modal.show();
  }


  document.getElementById('addTowhislistbtn').addEventListener('click', async (e)=>{
      e.preventDefault();
    const productId = e.currentTarget.dataset.productId;


const stockAvailable = <%= book.stock%>;
if(stockAvailable==false){
    showPopupAlert('This book is out of stock. Please check back later.')
     updateWishlistBadge(data.wishlistCount)
    return 
  }

    try {
       const res = await fetch('/wishlist/add',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({productId})
    })
  

    const data = await res.json();
      if(data.success){
        showPopupAlert(data.message)
      }else{
        showPopupAlert(data.message)
      }

      updateWishlistBadge(data.wishlistCount)

    } catch (error) {
       console.error('Wishlist error:', err);
    showPopupAlert('⚠️ Network or server error. Please try again.', 'Error');
    }
   

  })
</script>


<script>

function showPopupAlert(message, title = 'Notification') {
    document.getElementById('popupAlertTitle').innerText = title;
    document.getElementById('popupAlertMessage').innerText = message;
    const modalEl = document.getElementById('popupAlert');
    const modal = new bootstrap.Modal(modalEl, { backdrop: 'static' });
    modal.show();
  }

  const stockAvailable = <%= book.stock%>;
document.getElementById('buyNowBtn').addEventListener('click',(e)=>{
  const quantity = document.getElementById('quantityInput').value;
  const availableQuantity = document.getElementById('stock-info').dataset.stock;
  
  if(stockAvailable==false){
    showPopupAlert('This book is out of stock. Please check back later.')
    e.preventDefault();
    return 
  }
if(availableQuantity<quantity){
  showPopupAlert(`Only ${availableQuantity} quantity is left`);
    e.preventDefault();
    return 
}
  if(quantity>5){
    showPopupAlert('Only Five products are allowed');
    e.preventDefault();
    return 
  }
const hiddenQty = document.getElementById('hiddenQty');
hiddenQty.value = quantity;



  


})


</script>



