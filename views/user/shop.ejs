<%- include("../partials/user/header.ejs") %>

<div class="main-container">
  <section class="shop-page container">
    <div class="row">
      <!-- Sidebar Filters -->
      <aside class="col-md-3">
        <div class="filter-box border p-3 rounded">
          <h5 class="fw-bold">Filters</h5>
          <hr>

          <div id="categories-root" class="mb-3">
            <h6>Categories</h6>
            <div id="categories-list">Loading...</div>
          </div>

          <div id="brands-root" class="mb-3">
            <h6>Brands</h6>
            <div id="brands-list">Loading...</div>
          </div>

          <div class="mb-3">
            <h6>Price</h6>
            <div class="d-flex flex-column gap-2">
              <button type="button" class="btn btn-outline-dark" data-price="under100">Under ₹100</button>
              <button type="button" class="btn btn-outline-dark" data-price="100-250">₹100 - ₹250</button>
              <button type="button" class="btn btn-outline-dark" data-price="250-500">₹250 - ₹500</button>
              <button type="button" class="btn btn-outline-dark" data-price="above500">Above ₹500</button>
            </div>
          </div>
        </div>
      </aside>

      <!-- Products + Sorting -->
      <main class="col-md-9">
        <div class="d-flex justify-content-end mb-3">
          <ul id="sort-bar" class="nav nav-pills">
            <li class="nav-item"><button class="nav-link btn btn-link text-dark " data-sort="popularity">Popularity</button></li>
            <li class="nav-item"><button class="nav-link btn btn-link text-dark " data-sort="newest">Newest</button></li>
            <li class="nav-item"><button class="nav-link btn btn-link text-dark" data-sort="priceAsc">Price ↑</button></li>
            <li class="nav-item"><button class="nav-link btn btn-link text-dark" data-sort="priceDesc">Price ↓</button></li>
            <li class="nav-item"><button class="nav-link btn btn-link text-dark" data-sort="">Clear</button></li>
            
          </ul>
        </div>

        <div id="product-grid" class="row">
          <div class="col-12">Loading products...</div>
        </div>

        <div id="pagination" class="pagination mt-4"></div>
      </main>
    </div>
  </section>
</div>

<!-- Popup Modal -->
<div class="modal fade" id="popupAlert" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-dark text-white">
        <h5 class="modal-title" id="popupAlertTitle">Notification</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" id="popupAlertMessage"></div>
      <div class="modal-footer"><button class="btn btn-dark" data-bs-dismiss="modal">OK</button></div>
    </div>
  </div>
</div>



<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

<script>

const DEFAULT_LIMIT = 9;


function qs() { return new URLSearchParams(window.location.search); }
function setHistory(params, push = true) {
  if (!push) return;
  const url = '/shop?' + params.toString();
  window.history.pushState({ params: params.toString() }, '', url);
}
function showMessage(text) {
  const title = document.getElementById('popupAlertTitle');
  const body = document.getElementById('popupAlertMessage');
  if (title && body) {
    title.innerText = 'Notification';
    body.innerText = text;
    new bootstrap.Modal(document.getElementById('popupAlert')).show();
  } else {
    alert(text);
  }
}
function escapeHtml(unsafe) {
  if (unsafe === null || unsafe === undefined) return '';
  return String(unsafe)
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;')
    .replaceAll("'", '&#039;');
}

// wishlist update section

const userWishlist = new Set(); 

function updateWishlistBadge(count) {
  const badge = document.getElementById('wishlist-count-badge');
  if (!badge) return;
  badge.innerText = count;
  badge.style.display = Number(count) > 0 ? '' : 'none';
}
function updateCartBadge(count) {
  const badge = document.getElementById('cart-count-badge');
  if (!badge) return;
  if (Number(count) > 0) {
    badge.style.display = '';
    badge.innerText = count;
  } else {
    badge.style.display = 'none';
  }
}


async function fetchUserWishlist() {
  try {
    const res = await fetch('/wishlist', { credentials: 'include' });
    if (!res.ok) return;
    const data = await res.json();
    if (!data || !data.success || !Array.isArray(data.items)) return;
    userWishlist.clear();
    data.items.forEach(it => {
      
      const pid = it && it.productId && (it.productId._id || it.productId) ? String(it.productId._id || it.productId) : null;
      if (pid) userWishlist.add(pid);
    });
    updateWishlistBadge(userWishlist.size);
  } catch (err) {
    console.error('fetchUserWishlist error', err);
  }
}


function renderCategories(items) {
  const root = document.getElementById('categories-list');
  if (!root) return;
  root.innerHTML = items.map(c =>
    `<div class="form-check">
       <input class="form-check-input" type="checkbox" data-id="${c.id}" id="cat-${c.id}">
       <label class="form-check-label" for="cat-${c.id}">${escapeHtml(c.name)}</label>
     </div>`
  ).join('');
  root.querySelectorAll('input[type="checkbox"]').forEach(cb =>
    cb.addEventListener('change', () => applyFilter('category', cb.dataset.id))
  );
}
function renderBrands(items) {
  const root = document.getElementById('brands-list');
  if (!root) return;
  root.innerHTML = items.map(b =>
    `<div class="form-check">
       <input class="form-check-input" type="checkbox" data-id="${b.id}" id="brand-${b.id}">
       <label class="form-check-label" for="brand-${b.id}">${escapeHtml(b.brandName)}</label>
     </div>`
  ).join('');
  root.querySelectorAll('input[type="checkbox"]').forEach(cb =>
    cb.addEventListener('change', () => applyFilter('brand', cb.dataset.id))
  );
}


function renderProducts(products) {
  const grid = document.getElementById('product-grid');
  if (!grid) return;
  if (!products || products.length === 0) {
    grid.innerHTML = '<div class="col-12"><p>No products found.</p></div>';
    return;
  }

  grid.innerHTML = products.map(p => {
    const id = String(p.id || p._id || (p._id && p._id.toString && p._id.toString()) || '');
    const img = (p.productImage && p.productImage[0]) ? p.productImage[0] : '/images/no-image.png';
    const inWishlist = userWishlist.has(id);
    const heartClass = inWishlist ? 'bi-heart-fill' : 'bi-heart';
    const heartBtnClass = inWishlist ? 'btn-danger' : 'btn-outline-danger';

    return `<div class="col-md-4 mb-4">
      <div class="card h-100">
        <img src="${escapeHtml(img)}" class="card-img-top" alt="${escapeHtml(p.productName || '')}">
        <div class="card-body d-flex flex-column">
          <h6 class="card-title">${escapeHtml(p.productName || '')}</h6>
          <p class="mb-1">Brand: ${escapeHtml(p.brandName || 'N/A')}</p>
          <p>₹${escapeHtml(p.salePrice ?? '')} <span class="text-muted"><strike>₹${escapeHtml(p.regularPrice ?? '')}</strike></span></p>
          <div class="mt-auto d-flex justify-content-between">
            <a href="/book/${id}" class="btn btn-sm btn-outline-dark">View</a>
            <button class="btn btn-sm btn-dark" onclick="addToCart('${id}')">Add to Cart</button>
            <button
              class="btn btn-sm ${heartBtnClass}"
              onclick="toggleWishlist('${id}', this)"
              aria-pressed="${inWishlist ? 'true' : 'false'}"
              title="${inWishlist ? 'Remove from wishlist' : 'Add to wishlist'}"
            >
              <i class="bi ${heartClass}"></i>
            </button>
          </div>
        </div>
      </div>
    </div>`;
  }).join('');
}


function renderPagination(pagination) {
  const root = document.getElementById('pagination');
  if (!root) return;
  const cur = pagination.currentPage || 1;
  const total = pagination.totalPages || 1;
  let html = '';
  if (cur > 1) html += `<a class="btn btn-outline-dark" data-page="${cur-1}">Prev</a> `;
  for (let i = 1; i <= total; i++) {
    html += `<a class="btn ${i === cur ? 'btn-dark' : 'btn-outline-dark'}" data-page="${i}">${i}</a> `;
  }
  if (cur < total) html += `<a class="btn btn-outline-dark" data-page="${cur+1}">Next</a>`;
  root.innerHTML = html;
  root.querySelectorAll('[data-page]').forEach(el => el.addEventListener('click', () => goToPage(Number(el.dataset.page))));
}

function applyFilter(type, value) {
  const params = qs();
  if (type !== 'price') {
    const arr = params.get(type) ? params.get(type).split(',') : [];
    if (arr.includes(value)) {
      params.set(type, arr.filter(x => x !== value).join(','));
      if (!params.get(type)) params.delete(type);
    } else {
      arr.push(value);
      params.set(type, arr.join(','));
    }
  } else {
    const cur = params.get('price');
    if (cur === value) params.delete('price'); else params.set('price', value);
  }
  params.set('page', 1);
  loadProducts(params);
}

// sorting 
function applySort(val) {
  const params = qs();
  if (val) params.set('sort', val); else params.delete('sort');
  params.set('page', 1);
  loadProducts(params);
}
function goToPage(page) {
  const params = qs();
  params.set('page', page);
  loadProducts(params);
}

// add to cart function 

async function addToCart(productId) {
 const res =  await fetch('/cart/add', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ productId })
  })
  const data = await res.json();
  if (!data.success){
    showPopupAlert(data.message)
    return;
  }
  if(data.success){
    updateCartBadge(data.cartCount);
    showPopupAlert('Added to cart')
  }
    
}


async function toggleWishlist(productId, btnEl) {
  try {
    const inWL = userWishlist.has(String(productId));
    const url = inWL ? `/wishlist/remove/${productId}` : '/wishlist/add';  
    const res = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'include',
      body: inWL ? null : JSON.stringify({ productId }) 
    });

    const data = await res.json().catch(() => ({ success: false }));

    if (!res.ok || !data.success) {
      showMessage(data.message || (inWL ? 'Failed to remove' : 'Failed to add'));
      return;
    }

    if (inWL) userWishlist.delete(String(productId));
    else userWishlist.add(String(productId));

    refreshWishlistButton(btnEl, userWishlist.has(String(productId)));
    updateWishlistBadge(data.wishlistCount ?? userWishlist.size);
    showMessage(data.message);
  } catch (err) {
    console.error('toggleWishlist error', err);
    showMessage('Error processing wishlist action');
  }
}

function refreshWishlistButton(btnEl, isInWishlist) {
  if (!btnEl) return;
  const icon = btnEl.querySelector('i');
  if (isInWishlist) {
    btnEl.classList.remove('btn-outline-danger');
    btnEl.classList.add('btn-danger');
    if (icon) { icon.classList.remove('bi-heart'); icon.classList.add('bi-heart-fill'); }
    btnEl.setAttribute('aria-pressed', 'true');
    btnEl.title = 'Remove from wishlist';
  } else {
    btnEl.classList.remove('btn-danger');
    btnEl.classList.add('btn-outline-danger');
    if (icon) { icon.classList.remove('bi-heart-fill'); icon.classList.add('bi-heart'); }
    btnEl.setAttribute('aria-pressed', 'false');
    btnEl.title = 'Add to wishlist';
  }
}


async function loadFilters() {
  try {
    const r1 = await fetch('/api/categories', { credentials: 'include' });
    if (r1.ok) {
      const d1 = await r1.json().catch(() => null);
      if (d1 && d1.success && Array.isArray(d1.categories)) renderCategories(d1.categories);
      else document.getElementById('categories-list').innerText = 'No categories';
    } else {
      document.getElementById('categories-list').innerText = 'Error loading';
    }
  } catch (e) {
    document.getElementById('categories-list').innerText = 'Error loading';
  }

  try {
    const r2 = await fetch('/api/brands', { credentials: 'include' });
    if (r2.ok) {
      const d2 = await r2.json().catch(() => null);
      if (d2 && d2.success && Array.isArray(d2.brands)) renderBrands(d2.brands);
      else document.getElementById('brands-list').innerText = 'No brands';
    } else {
      document.getElementById('brands-list').innerText = 'Error loading';
    }
  } catch (e) {
    document.getElementById('brands-list').innerText = 'Error loading';
  }
}


async function loadProducts(params = qs(), pushHistory = true) {
  const grid = document.getElementById('product-grid');
  if (!grid) return;
  grid.innerHTML = '<div class="col-12"><p>Loading...</p></div>';

  if (!params.get('page')) params.set('page', 1);
  if (!params.get('limit')) params.set('limit', DEFAULT_LIMIT);

  try {
   
    const queryString = params.toString();
    const res = await fetch('/api/products?' + queryString, { credentials: 'include' });
    if (!res.ok) {
      grid.innerHTML = '<div class="col-12"><p>Error loading products</p></div>';
      return;
    }
    const data = await res.json().catch(() => null);
    if (data && data.success) {
      renderProducts(data.products || []);
      renderPagination(data.pagination || { currentPage: 1, totalPages: 1 });
      setHistory(params, pushHistory);
    } else {
      grid.innerHTML = '<div class="col-12"><p>No products</p></div>';
    }
  } catch (err) {
    console.error('loadProducts error', err);
    grid.innerHTML = '<div class="col-12"><p>Error loading products</p></div>';
  }
}


function setupSSE() {
  if (!('EventSource' in window)) return;
  const es = new EventSource('/api/updates/stream');
  es.addEventListener('reload', () => {
    loadFilters();
    loadProducts(qs(), false);
  });
  window.addEventListener('beforeunload', () => es.close());
}


window.addEventListener('popstate', ev => {
  const paramsStr = ev.state ? ev.state.params : window.location.search.substring(1);
  const params = new URLSearchParams(paramsStr);
  loadProducts(params, false);
});


document.addEventListener('DOMContentLoaded', () => {
  fetchUserWishlist().finally(() => {
    loadFilters().then(() => loadProducts(qs(), false));
  });

  // price buttons
  document.querySelectorAll('[data-price]').forEach(btn => btn.addEventListener('click', () => {
    applyFilter('price', btn.dataset.price);
  }));

  // sort bar
  document.querySelectorAll('#sort-bar [data-sort]').forEach(link => link.addEventListener('click', (ev) => {
    ev.preventDefault();
    applySort(link.dataset.sort || '');
  }));

  setupSSE();
});
</script>

<script>
  window.addEventListener('storage', (event) => {
    if (event.key === 'forceReload') {
      location.reload();
    }
  });
</script>

<%- include("../partials/user/footer.ejs") %>
