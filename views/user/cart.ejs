<%- include("../partials/user/header.ejs") %>

<div class="container my-5">
  <nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb small">
      <li class="breadcrumb-item"><a href="/">Home</a></li>
      <li class="breadcrumb-item active" aria-current="page">Cart</li>
    </ol>
  </nav>

  <!-- global alert container (one copy only) -->
  <div id="alert-container" class="mb-3"></div>

  <div class="row">
    <div class="col-12 col-lg-8">

      <% if (!items || items.length === 0) { %>
        <div class="alert alert-light border">Your cart is empty.</div>
      <% } else { %>
        <% items.forEach(function(it) { %>
          <% 
            const p = it.product || {};
            const title =  p.productName || 'Unknown Product';
            let image = (p.productImage && p.productImage[0])  || '/images/placeholder.png';
            const stock = Number(it.stock || 0);
            const qty = Number(it.qty || 0);
            const productMax = Number(it.productMax || 0);
            const outOfStock = !!it.outOfStock;
          %>

          <!-- add data-stock and data-product-max so client JS can read authoritative limits -->
          <div class="card mb-4" data-cart-item data-product-id="<%= p._id %>" data-stock="<%= stock %>" data-product-max="<%= productMax %>">
            <div class="card-body">
              <div class="row align-items-center">
                <div class="col-3 col-md-2">
                  <img src="<%= image %>" alt="<%= title %>" class="img-fluid" style="max-height:110px; object-fit:cover;">
                </div>

                <div class="col-7 col-md-8">
                  <h5 class="mb-2"><%= title %></h5>

                  <% if (outOfStock) { %>
                    <div class="text-danger small mb-2">Out of stock</div>
                  <% } else { %>
                    <div class="text-success small mb-2">In Stock <% if (stock) { %> — <small><%= stock %> left</small><% } %></div>
                  <% } %>

                  <div class="d-flex align-items-center gap-3">
                    <div class="d-flex align-items-center">
                      
                      <!-- increment and decrement button  -->
              
<div class="input-group" data-productid="<%= it.productId || (it.product && it.product._id) || '' %>">
  <button class="btn btn-dark btn-sm decrement">-</button>
  
  <input 
    type="number" 
    name="qty" 
    value="<%= qty %>" 
    min="1" 
    max="<%= (stock && productMax) ? Math.min(stock, productMax) : (stock || productMax || qty) %>" 
    class="form-control text-center quantity-input" 
    readonly
  >
  
  <button class="btn btn-dark btn-sm increment">+</button>
</div>





        
                    </div>

                    <div class="small text-muted ms-3">Quantity</div>
                  </div>

                  <% if (productMax) { %>
                    <div class="small text-muted mt-2">Max <strong><%= productMax %></strong> per order</div>
                  <% } %>

                </div>

                <div class="col-12 col-md-2 text-end mt-3 mt-md-0">
                  <div class="mb-3 price-display">Price <strong>₹<%= Number(it.priceAtAdd || p.price || 0).toFixed(2) %></strong></div>

                  <!-- remove -->
                  
                  <button type="button" class="btn btn-dark btn-sm"
                  data-removebtn
                  data-productid="<%= it.productId || (it.product && it.product._id) || '' %>">
                  Remove</button>
                </div>
              </div>
            </div>
          </div>
        <% }) %>

        <hr class="my-4" />
        <div class="d-flex justify-content-end">
          <h5>Total : <strong id="cart-page-total">₹<%= (typeof total !== 'undefined' ? parseFloat(total).toFixed(2) : '0.00') %></strong></h5>
        </div>
      <% } %>
    
    </div>

    <div class="col-12 col-lg-4">
      <div class="card border-1 p-3">
        <h5 class="mb-3">Cart Total</h5>
        <div class="d-flex justify-content-between small mb-2">
          <div>Subtotal:</div>
          <div id="cart-subtotal">₹<%= (typeof total !== 'undefined' ? parseFloat(total).toFixed(2) : '0.00') %></div>
        </div>
        <hr class="my-2">
        <div class="d-flex justify-content-between small mb-2">
          <div>Shipping:</div>
          <div>Free</div>
        </div>
        <hr class="my-2">
        <div class="d-flex justify-content-between fw-semibold mb-3">
          <div>Total:</div>
          <div id="cart-total">₹<%= (typeof total !== 'undefined' ? parseFloat(total).toFixed(2) : '0.00') %></div>
        </div>

        <div class="d-grid">
          <form action="/checkout" method="GET">
            <button class="btn btn-dark" type="submit">Proceed to checkout</button>
          </form>
        </div>
      </div>
      
    </div>

    
  </div>
</div>

<!-- remove button  -->
<script>
  document.addEventListener('click',async (e)=>{
    const btn = e.target.closest('button[data-removebtn]');
  if (!btn) return;          
  e.preventDefault();
    const productId = btn.dataset.productid;

    const result = await showConfirmModal('Are you sure to delete the item');
    if(!result){
      return;
    }
    const res = await fetch('/api/cart/delete',{
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
    body:JSON.stringify({productId}),
    })

    const data = await res.json();
    if(!data.success){
     showPopupAlert(data.message);
     return
    }
    location.reload();
  })
</script>

<!-- increment and decrement button -->

<script>
  document.addEventListener('click', async (e) => {
    if (e.target.classList.contains('increment') || e.target.classList.contains('decrement')) {
      const group = e.target.closest('.input-group');
      const input = group.querySelector('.quantity-input');
      const productId = group.dataset.productid;

      const min = parseInt(input.min) || 1;
      const max = parseInt(input.max) || 99;
      let value = parseInt(input.value);

      if (e.target.classList.contains('increment') && value < max) {
        value++;
      } else if (e.target.classList.contains('decrement') && value > min) {
        value--;
      }

      input.value = value; // update the input visually

  
      try {
        const res = await fetch(`/api/cart/update`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ productId, quantity: value })
        });
        const data = await res.json();
        if(!data.success){
          showPopupAlert(data.message);
          return
        }

        location.reload()

        
      } catch (err) {
        console.error('Error updating cart:', err);
      }
    }
  });
</script>

<%- include("../partials/user/footer.ejs") %>

<script>
  window.addEventListener('storage', (event) => {
    if (event.key === 'forceReload') {
      location.reload(); 
    }
  });
</script>
