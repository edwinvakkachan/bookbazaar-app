<%- include("../partials/user/header.ejs") %>

<!-- Hero Section -->
<section class="hero">
  <div class="hero-content">
    <h1>SMALL CHANGES,<br>BIG RESULTS</h1>
    <div class="price-tag">₹349 <span class="badge">BEST SELLER</span></div>
    <p>Transform your life with proven strategies and actionable insights from our bestselling collection.</p>
  </div>
  <div class="hero-image">
    <div class="book-cover-placeholder">Atomic<br>Habits<br><small>by James Clear</small></div>
  </div>
</section>

<!-- Popular Categories -->
<section class="popular-categories">
  <h2 class="section-title">Popular Categories</h2>
  <div class="categories"  id="popular-categories"></div>
</section>

<!-- Best Selling Books -->
<section>
  <h2 class="section-title">Best Selling Books</h2>
  <div class="bestselling-books" id="bestselling-books"></div>
</section>


<!-- About Us Section -->
        <section class="about-section">
            <h2>ABOUT US</h2>
        </section>



<!-- Latest Books -->
<section>
  <h2 class="section-title">Latest Books</h2>
  <div class="latest-books" id="latest-books"></div>
</section>

<%- include("../partials/user/footer.ejs") %>

<script>


async function fetchCategories() {
  const container = document.getElementById('popular-categories');
 
  try {
    const res = await fetch('/api/categories/popular', { method: 'GET', credentials: 'same-origin' });
    if (!res.ok) throw new Error('Fetch categories error: ' + res.status);
    const data = await res.json();
    if (!Array.isArray(data) || data.length === 0) {
      container.innerHTML = '<p>No categories found.</p>';
      return;
    }

    
    container.innerHTML = data.map(cat => {
      const idAttr = cat._id ? `data-id="${cat._id}"` : '';
      const name = cat.name  || 'Unnamed';
      return `<div class="category-card" ${idAttr} ><h3>${name}</h3></div>`;
    }).join('');

  } catch (err) {
    console.error('Error fetching categories', err);
    container.innerHTML = '<p class="error">Failed to load categories.</p>';
  }
}


function productHtml(p) {
  const img =  p.productImage[0] ||'';
  const price =  p.salePrice ||0
  const coverStyle = "background-image:url('" + img + "');background-size:cover;background-position:center;";
  const brandName = p.brand.brandName || '';
  const dataBrand = p.brand && p.brand._id ? `data-brand="${p.brand._id}"` : '';
  const dataCategory = p.category && p.category._id ? `data-category="${p.category._id}"` : '';
  return `
    <a href="/book/${p._id}" class="text-decoration-none text-dark product-item" data-id="${p._id}" ${dataBrand} ${dataCategory}>
      <div class="latest-book">
        <div class="latest-book-cover" style="${coverStyle}"></div>
        <div class="latest-book-info">
          <h4>${p.productName || 'Untitled'}</h4>
          ${ brandName ? `<p>${brandName}</p>` : '' }
          <div class="latest-book-price">₹${price}</div>
        </div>
      </div>
    </a>
  `;
}

async function fetchBestSelling() {
  const container = document.getElementById('bestselling-books');
  if (!container) return;
  try {
    const res = await fetch('/api/products/bestselling', { method: 'GET', credentials: 'same-origin' });
    if (!res.ok) throw new Error('Fetch best selling error: ' + res.status);
    const data = await res.json();
    const items = Array.isArray(data) ? data.filter(p => p && p.brand) : [];
    if (items.length === 0) {
      container.innerHTML = '<p>No best selling items.</p>';
      return;
    }
    container.innerHTML = items.map(productHtml).join('');
  } catch (err) {
    console.error('Error fetching best selling', err);
    container.innerHTML = '<p class="error">Failed to load best selling.</p>';
  }
}

async function fetchLatest() {
  const container = document.getElementById('latest-books');
  if (!container) return;
  try {
    const res = await fetch('/api/products/latest', { method: 'GET', credentials: 'same-origin' });
    if (!res.ok) throw new Error('Fetch latest error: ' + res.status);
    const data = await res.json();
    if (!Array.isArray(data) || data.length === 0) {
      container.innerHTML = '<p>No latest items.</p>';
      return;
    }
    container.innerHTML = data.map(productHtml).join('');
  } catch (err) {
    console.error('Error fetching latest', err);
    container.innerHTML = '<p class="error">Failed to load latest books.</p>';
  }
}

function loadAll() {
  fetchCategories();
  fetchBestSelling();
  fetchLatest();
}

function setupSSEwithReload() {
  if (!window.EventSource) return false;
  try {
    const es = new EventSource('/api/updates/stream');
    es.addEventListener('reload', () => {
      loadAll();
    });
    es.onerror = function(err) {
      console.warn('SSE error; falling back to polling', err);
      try { es.close(); } catch (e) {}
      return false;
    };
    return true;
  } catch (e) {
    console.warn('SSE setup failed', e);
    return false;
  }
}

let pollHandle = null;
function startPolling(intervalMs = 20000) {
  if (pollHandle) clearInterval(pollHandle);
  pollHandle = setInterval(loadAll, intervalMs);
}

document.addEventListener('DOMContentLoaded', function() {
  loadAll();
  const ok = setupSSEwithReload();
  if (!ok) startPolling(20000);
});
</script>


