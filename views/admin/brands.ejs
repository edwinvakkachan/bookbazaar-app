<%- include('../partials/admin/header') %>

    <!-- <link rel="stylesheet" href="/css/brands.css"> -->


<section class="content-main">
  <div class="content-header mb-4">
    <div>
      <h2 class="content-title card-title">Brands</h2>
    </div>
  </div>

  <div class="card">
    <div class="card-body">
      <div class="row">
        <!-- Brand Form -->
        <div class="col-md-3">
          <form method="post" action="/admin/addBrand" enctype="multipart/form-data">
            
            <div class="mb-4">
              <label for="brand_name" class="form-label">Brand Name</label>
              <input
                type="text"
                id="brand_name"
                name="name"
                placeholder="Type here"
                class="form-control"
              />
            </div>

            <div class="mb-4">
  <label for="brand_image" class="form-label">Brand Image</label>
  <div class="d-flex align-items-center gap-2">
    <img id="preview" 
     src="#" 
     alt="Preview" 
     class="rounded-circle border d-none" 
     style="width:40px; height:40px; object-fit:cover;" />
    <input class="form-control w-auto flex-grow-1" 
           id="brand_image" 
           name="image" 
           type="file" />
              </div>
            </div>

            <div class="d-grid">
              <button class="btn btn-dark mt-3" type="submit">
                Add Brand
              </button>
            </div>
          </form>
        </div>

        <!-- Brand Table -->
        <div class="col-md-9">
          <div class="table-responsive">
            <table class="table table-hover align-middle">
              <thead>
                <tr>
                  <th>Brand</th>
                  <th>Logo</th>
                  <!-- <th>Status</th> -->
                  <th>Block/Unblock/Delete</th>
                </tr>
              </thead>
              <tbody>
               <%data.forEach((brand,index)=>{%>
                <tr>
<td class="text-start"><%=brand.brandName%></td>
                  <td class="text-start">
                    <div class="d-flex align-items-center justify-content-center rounded-circle overflow-hidden" style="width:40px; height:40px;">
                      <img src="/uploads/reimage/<%=brand.brandImage[0]%>" alt="<%=brand.brandName%>" class="img-fluid" />
                    </div>
                  </td>
                  <!-- <td class="text-start">
                    <%if(brand.isBlocked){%>
                    <span class="badge bg-danger rounded-pill px-3">Blocked</span>
                    <%}else {%>
                    <span class="badge bg-success rounded-pill px-3">Active</span>
                    <%}%>
                  </td> -->
                  <td class="text-start">
                    <% if (!brand.isBlocked) { %>
    <button
      class="btn btn-danger btn-sm me-2 action-btn"
      data-id="<%= brand._id %>"
      data-action="block"
      data-message="Are you sure you want to block this brand?"
      data-bs-toggle="modal"
      data-bs-target="#confirmModal"
    >
      Block
    </button>
  <% } else { %>
    <button
      class="btn btn-success btn-sm me-2 action-btn"
      data-id="<%= brand._id %>"
      data-action="unblock"
      data-message="Are you sure you want to unblock this brand?"
      data-bs-toggle="modal"
      data-bs-target="#confirmModal"
    >
      Unblock
    </button>
  <% } %>
                    <a href="/admin/deleteBrand?id=<%=brand._id%>" class="btn btn-outline-danger btn-sm">Delete</a>
                  
                  </td>

                </tr>
               <%})%>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Pagination -->
<div class="pagination-container mt-4">
  <ul class="pagination justify-content-center">
    <% if (currentPage > 1) { %>
      <li class="page-item">
        <a class="page-link" href="/admin/brands?page=<%= currentPage - 1 %>">Previous</a>
      </li>
    <% } %>

    <% for (let i = 1; i <= totalPages; i++) { %>
      <li class="page-item <%= currentPage === i ? 'active' : '' %>">
        <a class="page-link" href="/admin/brands?page=<%= i %>"><%= i %></a>
      </li>
    <% } %>

    <% if (currentPage < totalPages) { %>
      <li class="page-item">
        <a class="page-link" href="/admin/brands?page=<%= currentPage + 1 %>">Next</a>
      </li>
    <% } %>
  </ul>
</div>

</section>

<!-- alert box -->
<div class="modal fade" id="popupAlert" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-dark text-white">
        <h5 class="modal-title" id="popupAlertTitle">Notification</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="popupAlertMessage"></div>
      <div class="modal-footer">
        <button type="button" class="btn btn-dark" data-bs-dismiss="modal">OK</button>
      </div>
    </div>
  </div>
</div>


<!-- Reusable Confirm Modal -->
<div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Confirm</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="confirmMessage">Are you sure?</div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" id="confirmBtnAjax" class="btn btn-danger">Yes, Proceed</button>
      </div>
    </div>
  </div>
</div>




<script>

document.getElementById("brand_image").addEventListener("change", function (event) {
  const preview = document.getElementById("preview");
  const file = event.target.files[0];
  if (file) {
    preview.src = URL.createObjectURL(file);
    preview.classList.remove("d-none");
  }
});


</script>

<%- include('../partials/admin/footer') %>

<script>
function showPopupAlert(message, title = 'Notification') {
    document.getElementById('popupAlertTitle').innerText = title;
    document.getElementById('popupAlertMessage').innerText = message;
    const modalEl = document.getElementById('popupAlert');
    const modal = new bootstrap.Modal(modalEl, { backdrop: 'static' });
    modal.show();
  }

 const confirmModal = document.getElementById('confirmModal');
  const confirmMessage = document.getElementById('confirmMessage');
  const confirmBtnAjax = document.getElementById('confirmBtnAjax');

  let currentAction = null;   
  let currentId = null;       
  let triggeringBtn = null; 


  confirmModal.addEventListener('show.bs.modal', (event) => {
    const button = event.relatedTarget;
     triggeringBtn = button;
     currentAction = button.dataset.action; 
     currentId = button.dataset.id;
    if (currentAction === 'unblock') {
      confirmBtnAjax.classList.remove('btn-danger');
      confirmBtnAjax.classList.add('btn-success');
      confirmBtnAjax.textContent = 'Yes, Unblock';
    } else if (currentAction === 'delete') {
      confirmBtnAjax.classList.remove('btn-success');
      confirmBtnAjax.classList.add('btn-danger');
      confirmBtnAjax.textContent = 'Yes, Delete';
    } else {

      confirmBtnAjax.classList.remove('btn-success');
      confirmBtnAjax.classList.add('btn-danger');
      confirmBtnAjax.textContent = 'Yes, Block';
    }
  })

  confirmBtnAjax.addEventListener('click', async ()=>{
try {
  const id=currentId
  const res = await fetch(`/admin/${currentAction}Brand`,{
  method:'POST',
  headers:{'Content-Type':'application/json'},
  body:JSON.stringify({id})
})

const json = await res.json();
if(json.success){
  if (json.isBlocked == true) {
            triggeringBtn.textContent = 'Unblock';
            triggeringBtn.classList.remove('btn-danger');
            triggeringBtn.classList.add('btn-success');
            triggeringBtn.dataset.action = 'unblock';
            triggeringBtn.dataset.message = 'Are you sure you want to unblock this brand?';
          } else {
            triggeringBtn.textContent = 'Block';
            triggeringBtn.classList.remove('btn-success');
            triggeringBtn.classList.add('btn-danger');
            triggeringBtn.dataset.action = 'block';
            triggeringBtn.dataset.message = 'Are you sure you want to block this brand?';
          }
}else{
  showPopupAlert(json.message)
  return
}
const modalInstance = bootstrap.Modal.getInstance(confirmModal);
      modalInstance.hide();
      localStorage.setItem('forceReload', Date.now());// user side reload
} catch (error) {
  showPopupAlert(error)
  return
}

  })



</script>
