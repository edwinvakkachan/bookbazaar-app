<%- include('../partials/admin/header') %>

    <!-- <link rel="stylesheet" href="/css/brands.css"> -->


<section class="content-main">
  <div class="content-header mb-4">
    <div>
      <h2 class="content-title card-title">Brands</h2>
    </div>
  </div>

  <div class="card">
    <div class="card-body">
      <div class="row">
        <!-- Brand Form -->
        <div class="col-md-3">
          <form method="post" id="brandForm" action="/admin/addBrand" enctype="multipart/form-data">
            
            <div class="mb-4">
              <label for="brand_name" class="form-label">Brand Name</label>
              <input
                type="text"
                id="brand_name"
                name="brandName"
                placeholder="Type here"
                class="form-control"
              />
            </div>

            <div class="mb-4">
  <label for="brand_image" class="form-label">Brand Image</label>
  <div class="d-flex align-items-center gap-2">
    <img id="preview" 
     src="#" 
     alt="Preview" 
     class="rounded-circle border d-none" 
     style="width:40px; height:40px; object-fit:cover;" />
    <input class="form-control w-auto flex-grow-1" 
           id="brand_image" 
           name="image" 
           type="file" />
              </div>
            </div>

            <div class="d-grid">
              <button class="btn btn-dark mt-3" type="submit">
                Add Brand
              </button>
            </div>
          </form>
        </div>

        <!-- Brand Table -->
        <div class="col-md-9">
          <div class="table-responsive">
            <table class="table table-hover align-middle">
              <thead>
                <tr>
                  <th>Brand</th>
                  <th>Logo</th>
                  <th>Status</th>
                  <th>Block/Unblock/Delete</th>
                </tr>
              </thead>
              <tbody>
               <%data.forEach((brand,index)=>{%>
                <tr>
<td class="text-start"><%=brand.brandName%></td>
                  <td class="text-start">
                    <div class="d-flex align-items-center justify-content-center rounded-circle overflow-hidden" style="width:40px; height:40px;">
                      <img src="/uploads/reimage/<%=brand.brandImage[0]%>" alt="<%=brand.brandName%>" class="img-fluid" />
                    </div>
                  </td>
                  <td class="text-start">
                    <%if(brand.isBlocked){%>
                    <span class="badge bg-danger rounded-pill px-3">Blocked</span>
                    <%}else {%>
                    <span class="badge bg-success rounded-pill px-3">Active</span>
                    <%}%>
                  </td>
                  <td class="text-start">
                    <% if (!brand.isBlocked) { %>
    <button
      class="btn btn-danger btn-sm me-2 action-btn"
      data-id="<%= brand._id %>"
      data-action="block"
    >
      Block
    </button>
  <% } else { %>
    <button
      class="btn btn-success btn-sm me-2 action-btn"
      data-id="<%= brand._id %>"
      data-action="unblock"
    >
      Unblock
    </button>
  <% } %>
                    
              
                    <button
      class="btn btn-outline-danger btn-sm action-btn"
      data-id="<%= brand._id %>"
      data-action="delete"
    >
      Delete
    </button>




                  </td>

                </tr>
               <%})%>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Pagination -->
<div class="pagination-container mt-4">
  <ul class="pagination justify-content-center">
    <% if (currentPage > 1) { %>
      <li class="page-item">
        <a class="page-link" href="/admin/brands?page=<%= currentPage - 1 %>">Previous</a>
      </li>
    <% } %>

    <% for (let i = 1; i <= totalPages; i++) { %>
      <li class="page-item <%= currentPage === i ? 'active' : '' %>">
        <a class="page-link" href="/admin/brands?page=<%= i %>"><%= i %></a>
      </li>
    <% } %>

    <% if (currentPage < totalPages) { %>
      <li class="page-item">
        <a class="page-link" href="/admin/brands?page=<%= currentPage + 1 %>">Next</a>
      </li>
    <% } %>
  </ul>
</div>

</section>


<script>

document.getElementById("brand_image").addEventListener("change", function (event) {
  const preview = document.getElementById("preview");
  const file = event.target.files[0];
  if (file) {
    preview.src = URL.createObjectURL(file);
    preview.classList.remove("d-none");
  } else {
    preview.classList.add("d-none");
  }
});

function validate(brandName) {
  let isValid = true;
  if (!brandName || brandName.trim() === '') {
    showPopupAlert('Brand name should not be empty');
    isValid = false;
  }
  return isValid;
}

document.getElementById('brandForm').addEventListener('submit', async (e) => {
  e.preventDefault();

  const form = e.target;
  const brandName = form.brandName.value; 

  if (!validate(brandName)) return;

  const formData = new FormData(form); // captures file input + text inputs

  try {
    const res = await fetch('/admin/addBrand', {
      method: 'POST',
      body: formData, 
    });

    const data = await res.json();
    if (!data.success) {
      showPopupAlert(data.message);
      return;
    }

    location.reload();
    showPopupAlert(data.message);
   
  } catch (err) {
    console.error(err);
    showPopupAlert('Network error');
  }
});
</script>

<!-- block and ublock and delete -->
 <script>
  document.addEventListener('click',async (e)=>{
    const btn = e.target.closest('.action-btn');
    const action = btn.dataset.action;
    const brandId = btn.dataset.id;
    const result = await showConfirmModal(`Are you sure to ${action} brand`);
    if(!result){
      return;
    }
    if(action=='block'){
      const res = await fetch('/admin/blockBrand',{
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({brandId})
      })

      const data = await res.json();
      if(!data.success){
        return showPopupAlert(data.message);
      }
     location.reload() 
    }

    // unblocking brand 
    else if(action=='unblock'){
      const res = await fetch('/admin/unblockBrand',{
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({brandId})
      })
      const data = await res.json();
      if(!data.success){
        showPopupAlert(data.message);
        return
      }
      location.reload();
    }
    // deleting the brand

    else if(action=='delete'){
      const res = await fetch('/admin/deleteBrand',{
        method:'DELETE',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({brandId})
      })
      const data = await res.json();
      if(!data.success){
        showPopupAlert(data.message);
        return;
      }
      location.reload();
    }

  })
 </script>
<%- include('../partials/admin/footer') %>
