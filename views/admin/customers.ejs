<%- include('../partials/admin/header') %>

<h2 class="page-title mb-3">Customers</h2>

<!-- Search & Sort -->



<!-- Customers Table -->


<div class="container my-5">
  <h4 class="mb-4 fw-bold">Customer List</h4>
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div class="input-group" style="width: 250px;">
      <input type="text" id="searchInput" class="form-control" placeholder="Search user...">
      <button class="btn btn-primary" id="searchBtn">Search</button>
    </div>
  </div>
      
  <div class="table-responsive">

    <table class="table table-hover align-middle text-center" id="customerTable">
      <thead class="table-light">
        <tr>
          <th>NAME</th>
          <th>EMAIL</th>
          <th>PHONE</th>
          <th>STATUS</th>
          <th>ACTION</th>
        </tr>
      </thead>
      <tbody id="customerBody">
        <!-- Rows will be inserted dynamically -->
      </tbody>
    </table>



<nav class="mt-3">
  <ul class="pagination justify-content-center" id="pagination"></ul>
</nav>


  </div>
</div>






<script>

  let pagination; 
let searchInput;
let searchBtn;
let currentPage = 1;
let currentSearch='';

async function loadCustomers(page = 1,search = ''){
  try {
    // const res = await fetch(`/admin/api/customers?page=${page}${search ? '&search=' + encodeURIComponent(search) : ''}`);
    const res = await fetch(`/admin/api/customers?page=${page}&search=${search}`);
  const data = await res.json();
  if(!data.success){
showPopupAlert(data.message)
  }

 currentPage = data.page;
currentSearch = data.search || search || '';


const tbody = document.getElementById('customerBody');
tbody.innerHTML='';
data.users.forEach(user => {
  const row = document.createElement('tr');
      row.id = `user-${user._id}`;
      row.innerHTML = `
        <td>${user.name}</td>
        <td>${user.email}</td>
        <td>${user.phone || '-'}</td>
        <td>
          <span class="badge ${user.isBlocked ? 'bg-danger' : 'bg-success'}">
            ${user.isBlocked ? 'Blocked' : 'Active'}
          </span>
        </td>
        <td>
          <button
            class="btn btn-sm ${user.isBlocked ? 'btn-outline-success' : 'btn-danger'} block-toggle-btn"

            data-id="${user._id}"
            data-blocked="${user.isBlocked}">
            ${user.isBlocked ? 'Unblock' : 'Block'}
          </button>
        </td>
      `;
      tbody.appendChild(row);
});




// pagination 
 pagination.innerHTML = '';
    for (let i = 1; i <= data.totalPages; i++) {
      const li = document.createElement('li');
      li.className = `page-item ${i === data.page ? 'active' : ''}`;
      li.innerHTML = `<a href="#" class="page-link">${i}</a>`;
      li.addEventListener('click', e => {
        e.preventDefault();
        currentPage = i;
        loadCustomers(currentPage,currentSearch);
      });
      pagination.appendChild(li);
    }


   searchBtn.addEventListener('click', () => {
    loadCustomers(1, searchInput.value);
  });


  } catch (error) {
    
  }
}




document.addEventListener('DOMContentLoaded',async ()=>{
   pagination = document.getElementById('pagination');
   searchInput = document.getElementById('searchInput');
   searchBtn = document.getElementById('searchBtn');
  let currentSearch = '';


 await loadCustomers(currentPage,'')


 document.getElementById('customerTable').addEventListener('click',async (e)=>{
  const btn = e.target.closest('.block-toggle-btn');
  const userId = btn.dataset.id
   const result = await showConfirmModal('Do you want to procced ?', 'Confirm Block');
   if(!result){
    return;
   }
  if(btn.dataset.blocked == 'false'){
const res = await fetch('/admin/blockUser',{
     method: 'PATCH',
      headers: {
        'Content-Type': 'application/json',
      },
    body:JSON.stringify({ userId}),
  })

const data = await res.json();
if(!data.success){
 showPopupAlert(data.message);
}
  }
  
  else{
    const res = await fetch('/admin/unblockUser',{
      method:'PATCH',
      headers:{
        'Content-Type':'application/json',
      },
      body:JSON.stringify({userId})
    })
    const data = await res.json();
    if(!data.success){
      showPopupAlert(data.message);
    }
  }
  
 await loadCustomers(currentPage,currentSearch);
 })

})




</script>








<%- include('../partials/admin/footer') %>
