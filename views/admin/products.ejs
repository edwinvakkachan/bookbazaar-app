<%- include('../partials/admin/header') %>


<div class="content-header mb-3">
  <h2 class="page-title">Products</h2>
</div>

<header class="card-header text-center mb-4">
  <form action="" method="get" class="d-inline">
    <div class="input-group input-group-sm border border-1 border-secondary rounded-pill mx-auto" style="max-width: 500px;">
      <input type="text" class="form-control border-0 rounded-pill" placeholder="Search products or brands" name="search">
      <button class="btn border-0" type="submit">Search</button>
    </div>
  </form>
</header>

<div class="mt-3">
  <table class="table table-striped align-middle">
    <thead>
      <tr>
        <th><b>Product name</b></th>
        <th><b>Brand</b></th>
        <th><b>Category</b></th>
        <th><b>Sale Price</b></th>
        <th><b>Offer Price</b></th>
        <th><b>Offer</b></th>
        <th><b>Quantity</b></th>
        <th><b>Action</b></th>
        <th><b>Edit</b></th>
      </tr>
    </thead>
    <tbody>
        <%for(let i=0;i<data.length;i++) {%>
      <!-- Example row  -->
      <tr>
  <td><%= data[i].productName %></td>
  <td><%= data[i].brand?.brandName || "N/A" %></td>
  <td><%= data[i].category?.name || "N/A" %></td>
  <td><%= data[i].salePrice %></td>
  <td><%= data[i].offerPrice || "-" %></td>

  <td>
  <div class="d-flex justify-content-center gap-2">
    <a href="#" class="btn btn-dark btn-sm text-white">Add Offer</a>
    <a href="#" class="btn btn-dark btn-sm text-white">Remove</a>
  </div>
</td>


  <td><%= data[i].quantity %></td>

  <!-- <td>
    <% if (!data[i].isBlocked) { %>
      <a href="/admin/blockProduct?id=<%= data[i]._id %>" class="btn btn-danger btn-sm text-white" style="width: 80px;">Block</a>
    <% } else { %>
      <a href="/admin/unblockProduct?id=<%= data[i]._id %>" class="btn btn-success btn-sm text-white" style="width: 80px;">Unblock</a>
    <% } %>
  </td> -->


  <td>
  <% if (!data[i].isBlocked) { %>
    <button
      class="btn btn-danger btn-sm text-white action-btn"
      style="width: 80px;"
      data-id="<%= data[i]._id %>"
      data-bs-toggle="modal"
      data-bs-target="#confirmModal"
      data-action="block"
      data-message="Are you sure you want to block this product?"
    >
      Block
    </button>
  <% } else { %>
    <button
      class="btn btn-success btn-sm text-white action-btn"
      style="width: 80px;"
      data-id="<%= data[i]._id %>"
      data-bs-toggle="modal"
      data-bs-target="#confirmModal"
      data-action="unblock"
      data-message="Are you sure you want to unblock this product?"
    >
      Unblock
    </button>
  <% } %>
</td>


  <td>
    <a href="/admin/editProduct/<%= data[i]._id %>" class="btn btn-dark btn-sm text-white" style="width: 80px;">Edit</a>
  </td>
</tr>

      <%}%>
    </tbody>
  </table>
</div>

<div class="container mt-3">
   <nav aria-label="Page navigation">
       <ul class="pagination justify-content-center mb-20" style="margin-right: 200px;">


           <% for (let i = 1; i <= totalPages; i++) { %>
           <li class="page-item <%=(i === currentPage) ? 'active' : '' %>">
               <a class="page-link" href="?page=<%= i %>"><%= i %></a>
           </li>
           <% } %>


       </ul>
   </nav>
</div>
<!-- modal for conformation -->

<div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Confirm Action</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" id="confirmMessage">Are you sure?</div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" id="confirmBtnAjax" class="btn btn-danger">Yes, Proceed</button>
      </div>
    </div>
  </div>
</div>


<!-- alert box -->
<div class="modal fade" id="popupAlert" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-dark text-white">
        <h5 class="modal-title" id="popupAlertTitle">Notification</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="popupAlertMessage"></div>
      <div class="modal-footer">
        <button type="button" class="btn btn-dark" data-bs-dismiss="modal">OK</button>
      </div>
    </div>
  </div>
</div>

<!-- Page-specific scripts  -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@10/dist/sweetalert2.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

<%- include('../partials/admin/footer') %>

<script>

function showPopupAlert(message, title = 'Notification') {
    document.getElementById('popupAlertTitle').innerText = title;
    document.getElementById('popupAlertMessage').innerText = message;
    const modalEl = document.getElementById('popupAlert');
    const modal = new bootstrap.Modal(modalEl, { backdrop: 'static' });
    modal.show();
  }




const confirmModal = document.getElementById('confirmModal');
const confirmMessage = document.getElementById('confirmMessage');
const confirmBtnAjax = document.getElementById('confirmBtnAjax');

confirmModal.addEventListener('show.bs.modal',(event)=>{
  const button = event.relatedTarget;
  currentProductId = button.dataset.id;
  currentAction = button.dataset.action;
  triggeringBtn = button;

if (currentAction === 'unblock') {
      confirmBtnAjax.classList.remove('btn-danger');
      confirmBtnAjax.classList.add('btn-success');
      confirmBtnAjax.textContent = 'Yes, Unblock';
    } else {
      confirmBtnAjax.classList.remove('btn-success');
      confirmBtnAjax.classList.add('btn-danger');
      confirmBtnAjax.textContent = 'Yes, Block';
    }



})


confirmBtnAjax.addEventListener('click',async ()=>{
 try {
  const id = currentProductId ;
   const  res = await fetch(`/admin/${currentAction}Product`,{
    method:'POST',
    headers:{
      'Content-Type':'application/json'
    },
    body:JSON.stringify({id})
   })
   const json = await res.json();
   if(json.success){
    
    if (json.isBlocked) {
          triggeringBtn.textContent = 'Unblock';
          triggeringBtn.classList.remove('btn-danger');
          triggeringBtn.classList.add('btn-success');
          triggeringBtn.dataset.action = 'unblock';
          triggeringBtn.dataset.message = 'Are you sure you want to unblock this product?';
        } else {
          triggeringBtn.textContent = 'Block';
          triggeringBtn.classList.remove('btn-success');
          triggeringBtn.classList.add('btn-danger');
          triggeringBtn.dataset.action = 'block';
          triggeringBtn.dataset.message = 'Are you sure you want to block this product?';
        }

        // Close modal
        const modalInstance = bootstrap.Modal.getInstance(confirmModal);
        modalInstance.hide();

 localStorage.setItem('forceReload', Date.now()); //user page reloading

      } else {
        
        showPopupAlert(json.message);
      }
 } catch (error) {
  showPopupAlert('Something went wrong.')
 }finally {
      confirmBtnAjax.disabled = false;
      confirmBtnAjax.textContent = originalText;
    }
})


</script>
